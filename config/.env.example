# ============================================================
# ComfyUI Social Media Suite - Variables de entorno
# ============================================================
# Copia este archivo a .env y rellena tus credenciales.
# NUNCA subas el archivo .env a git (ya esta en .gitignore).

# ---- ComfyUI ----
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188

# ---- Instagram (instagrapi - cuenta personal) ----
# Advertencia: usar la API privada puede violar ToS de Instagram.
# Para produccion, considera migrar a Graph API con cuenta Business.
IG_USERNAME=tu_usuario_instagram
IG_PASSWORD=tu_password_instagram

# ---- Twitter/X (API v2 + media v1.1) ----
# Consigue las credenciales en: https://developer.twitter.com/
# Tier Free: 1500 tweets/mes SIN media. Para media necesitas Basic ($200/mes)
# Workaround: usar cuenta legacy con v1.1 o unificar via Ayrshare.
TWITTER_BEARER_TOKEN=
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ---- Facebook (Graph API - Pagina) ----
# 1. Crea una app en: https://developers.facebook.com/
# 2. Obtten el Page Access Token con permisos:
#    pages_manage_posts, pages_read_engagement
FB_PAGE_ID=1234567890
FB_PAGE_TOKEN=

# ---- Pinterest (API v5 o py3-pinterest) ----
# Para py3-pinterest: usa tu email + password + username
PINTEREST_EMAIL=
PINTEREST_PASSWORD=
PINTEREST_USERNAME=
PINTEREST_BOARD_ID=

# ---- Opcional: Ayrshare (API unificada 13+ redes) ----
# Si prefieres no mantener 6 OAuth separadas, usa Ayrshare.
# https://app.ayrshare.com/
AYRSHARE_API_KEY=

# ---- Opcional: OpenAI para generacion de captions ----
OPENAI_API_KEY=

# ---- Opcional: CivitAI token para descargar modelos ----
CIVITAI_TOKEN=

# ---- Opcional: Cloudinary (hosting publico de imagenes) ----
# Muchas APIs sociales requieren URL publica para la imagen.
# Si no usas Cloudinary, sube a S3, Imgur, o tu propio servidor.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- YouTube (OAuth flow) ----
# 1. Crea un proyecto en https://console.cloud.google.com/
# 2. Habilita YouTube Data API v3
# 3. Crea OAuth 2.0 Client ID (tipo Desktop)
# 4. Descarga el JSON y guárdalo como client_secret.json en la raíz del proyecto
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json

# ---- TikTok (credenciales de cuenta) ----
# ADVERTENCIA: usa una cuenta de prueba, hay riesgo de ban.
TIKTOK_USERNAME=
TIKTOK_PASSWORD=

# ---- Webhook server (para ComfyUI-WebhookNotifier) ----
# Si activas scripts/webhook_server.py, define un secreto para validar
# las peticiones entrantes
WEBHOOK_SECRET=cambia_esto_por_un_secreto_aleatorio

# ---- Telegram bot (opcional, para control remoto) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=123456789,987654321

# ---- Analytics (opcional, para engagement tracking) ----
# Twitter bearer token es necesario para analytics_collector.py
# (ya definido arriba como TWITTER_BEARER_TOKEN)

# ---- z-ai-web-dev-sdk (alternativa a OpenAI para captions) ----
ZAI_API_KEY=

# ---- Ollama local (alternativa gratuita a OpenAI) ----
# Solo configurar si tienes Ollama corriendo en localhost:11434
OLLAMA_HOST=http://localhost:11434

# ---- MCP server (para integracion con agentes AI) ----
# No requiere vars extra, pero el servidor debe poder leer .env
# Configurar clientes (Claude/Hermes/Cursor) apuntando a:
#   command: python
#   args: [scripts/mcp_agent_tools.py]

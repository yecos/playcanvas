# ============================================
# ComfyUI Social Media Suite - .gitignore
# ============================================

# --- Env files (NEVER commit credentials) ---
.env
.env.*
!config/.env.example

# --- Sessions / tokens / credentials cache ---
ig_session.json
youtube_token.json
pinterest_creds/
pinterest_creds/**
*.session
client_secret.json

# --- Temp ---
*.tmp
*.bak
*.cache
.cache/

# --- ComfyUI core (cloned by installer) ---
ComfyUI/
comfyui/
ComfyUI_windows_portable/

# --- Python virtual environments ---
venv/
.venv/
env/
ENV/
*.pyc
__pycache__/
*.pyo
*.egg-info/
dist/
build/

# --- Downloaded models (too large for git) ---
ComfyUI/models/checkpoints/*.safetensors
ComfyUI/models/checkpoints/*.pth
ComfyUI/models/checkpoints/*.ckpt
ComfyUI/models/loras/*.safetensors
ComfyUI/models/vae/*.safetensors
ComfyUI/models/vae/*.pth
ComfyUI/models/embeddings/*.pt
ComfyUI/models/embeddings/*.safetensors
ComfyUI/models/controlnet/*.safetensors
ComfyUI/models/controlnet/*.pth
ComfyUI/models/animatediff_models/*.safetensors
ComfyUI/models/upscale_models/*.pth
ComfyUI/models/upscale_models/*.safetensors
ComfyUI/models/diffusion_models/*.safetensors
ComfyUI/models/text_encoders/*.safetensors
ComfyUI/models/text_encoders/*.gguf
ComfyUI/models/clip_vision/*.safetensors
ComfyUI/models/clip_vision/*.pth

# --- Custom nodes (installed by script) ---
ComfyUI/custom_nodes/*
!ComfyUI/custom_nodes/.gitkeep

# --- Output images / videos (user-generated) ---
ComfyUI/output/*
!ComfyUI/output/.gitkeep

# --- Logs ---
*.log
logs/
ComfyUI/*.log

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo

# --- Temp ---
*.tmp
*.bak
*.cache
.cache/
